# Desk Dashboard configuration. Copy to .env (gitignored) and fill in.
# Every secret can instead be read from a file: set NAME_FILE=/run/secrets/name.
# Placeholder values only; never commit the real file.

# --- Required -----------------------------------------------------------------
# Comma-separated bearer tokens, one per screen. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKENS=changeme-browser-token,changeme-esp32-token

# --- Portfolio: SimpleFIN Bridge (holdings) -----------------------------------
# Secret. The Access URL you get by claiming a SimpleFIN setup token.
SIMPLEFIN_ACCESS_URL=
# Optional: account IDs or case-insensitive name substrings. Default: every
# account that has holdings.
SIMPLEFIN_ACCOUNTS=
# Fetch times, America/New_York.
SIMPLEFIN_FETCH_TIMES=06:00,20:00
# Hard cap per rolling 24 h, persisted in /data.
SIMPLEFIN_MAX_REQUESTS_PER_DAY=4

# --- Portfolio: Finnhub (quotes) ----------------------------------------------
# Secret. Free key from finnhub.io.
FINNHUB_API_KEY=
QUOTE_INTERVAL_SECONDS=60
# Optional YAML merged over config/fund-proxies.yaml (mount it into the container).
FUND_PROXIES_FILE=
# Optional: replaces the default list of money-market / sweep tickers.
CASH_SYMBOLS=

# --- Server metrics -----------------------------------------------------------
# unraid (default when UNRAID_GRAPHQL_URL is set), host, or off.
SERVER_METRICS_SOURCE=
# The Unraid web UI address plus /graphql. Use the LAN IP, and include a custom
# web UI port if you use one, e.g. http://192.168.1.10:8443/graphql
UNRAID_GRAPHQL_URL=http://192.168.1.10/graphql
# Secret. Unraid API key with the Viewer role.
UNRAID_API_KEY=
METRICS_INTERVAL_SECONDS=5
CPU_SMOOTHING_SECONDS=30
SERVER_DISPLAY_NAME=Server

# --- Display / misc -------------------------------------------------------------
HIDE_DOLLAR_AMOUNTS=false
# true: synthetic data, no keys or network calls needed.
DEMO_MODE=false
LOG_LEVEL=info

# --- Tailscale sidecar (only with deploy/tailscale/compose.tailscale.yml) -----
TS_AUTHKEY=
